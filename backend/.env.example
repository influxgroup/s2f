APP_NAME="Sovereign2Fresh Empire API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sovereign2freshempire.com
FRONTEND_URL=https://sovereign2freshempire.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Hostinger Agency MySQL Database Configuration ───
# In Hostinger hPanel -> Databases -> MySQL Databases:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_hostinger_db_name
DB_USERNAME=your_hostinger_db_username
DB_PASSWORD=your_hostinger_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail Settings (Hostinger Titan/Business Email) ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=consult@sovereign2freshempire.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="consult@sovereign2freshempire.com"
MAIL_FROM_NAME="${APP_NAME}"
